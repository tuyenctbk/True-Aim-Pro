    <string name="guide_step_format">Step %1$d of %2$d</string>
    <string name="tooltip_step1_title">1. Enable \'Draw Over Other Apps\'</string>
    <string name="tooltip_step1_desc">Android requires permission to float your custom crosshair over games. Grant \'Display over other apps\' to allow HUD projection.</string>
    <string name="tooltip_step1_granted">✓ Permission Enabled</string>
    <string name="tooltip_step1_grant">Grant Permission</string>
    <string name="tooltip_step2_title">2. Customize Reticle &amp; Color</string>
    <string name="tooltip_step2_desc">Choose from 16+ styles (Dots, Circles, Crosses), customize hex colors in real-time, and set alpha transparency so targets stay clear.</string>
    <string name="tooltip_step2_action">Explore Reticle Gallery</string>
    <string name="tooltip_step3_title">3. Launch In-Game Overlay HUD</string>
    <string name="tooltip_step3_desc">Flip the Master Switch to project the reticle on screen. Use the on-screen D-Pad to calibrate pixel alignment while in game.</string>
    <string name="tooltip_step3_running">✓ Overlay Running</string>
    <string name="tooltip_step3_activate">Activate Floating HUD</string>
    <string name="tutorial_point1_title">1. Master Overlay Power</string>
    <string name="tutorial_point1_desc">Tap the top Master Switch to activate/deactivate the crosshair on top of all games.</string>
    <string name="tutorial_point2_title">2. Reticle Style Carousel</string>
    <string name="tutorial_point2_desc">Tap any reticle shape (Dot, Circle, Cross, Tactical) to switch crosshair geometry instant.</string>
    <string name="tutorial_point3_title">3. Dynamic Color Studio</string>
    <string name="tutorial_point3_desc">Tap the Hex code field or RGB sliders to match crosshair color with target backgrounds.</string>
    <string name="tutorial_point4_title">4. Alpha Transparency Control</string>
    <string name="tutorial_point4_desc" formatted="false">Slide the opacity bar from 10% to 100% so your target view is never blocked.</string>
