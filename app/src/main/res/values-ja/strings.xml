    <string name="tooltip_step2_title">2. Customize Reticle &amp; Color</string>
    <string name="tooltip_step2_desc">Choose from 16+ styles (Dots, Circles, Crosses), customize hex colors in real-time, and set alpha transparency so targets stay clear.</string>
