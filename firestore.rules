rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUsageQuota(data) {
      return data.keys().hasAll([
               'userId',
               'dateIso',
               'architectUsed',
               'visionUsed',
               'coachUsed',
               'bonusGraceCredits',
               'graceClaimed',
               'ecoLiteMode',
               'fallbackCascadeCount',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'dateIso',
               'architectUsed',
               'visionUsed',
               'coachUsed',
               'bonusGraceCredits',
               'graceClaimed',
               'ecoLiteMode',
               'fallbackCascadeCount',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.dateIso is string &&
             data.dateIso.size() == 10 &&
             data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.architectUsed is int &&
             data.architectUsed >= 0 &&
             data.architectUsed <= 500 &&
             data.visionUsed is int &&
             data.visionUsed >= 0 &&
             data.visionUsed <= 500 &&
             data.coachUsed is int &&
             data.coachUsed >= 0 &&
             data.coachUsed <= 500 &&
             data.bonusGraceCredits is int &&
             data.bonusGraceCredits >= 0 &&
             data.bonusGraceCredits <= 3 &&
             data.graceClaimed is bool &&
             data.ecoLiteMode is bool &&
             data.fallbackCascadeCount is int &&
             data.fallbackCascadeCount >= 0 &&
             data.fallbackCascadeCount <= 500 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/usageQuota/{periodId} {
      allow get: if isOwner(userId) && isValidId(periodId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       periodId == 'daily' &&
                       isValidUsageQuota(incoming()) &&
                       incoming().bonusGraceCredits == 0 &&
                       incoming().graceClaimed == false;

      allow update: if isOwner(userId) &&
                       periodId == 'daily' &&
                       isValidUsageQuota(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Record AI interaction usage, refund, or fallback cascade
                         (
                           incoming().dateIso == existing().dateIso &&
                           incoming().diff(existing()).affectedKeys().hasAny([
                             'architectUsed',
                             'visionUsed',
                             'coachUsed',
                             'fallbackCascadeCount'
                           ]) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'architectUsed',
                             'visionUsed',
                             'coachUsed',
                             'fallbackCascadeCount',
                             'updatedAt'
                           ])
                         ) ||
                         // Action 2: Claim one-time daily +3 grace credits
                         (
                           existing().graceClaimed == false &&
                           incoming().graceClaimed == true &&
                           incoming().bonusGraceCredits == 3 &&
                           incoming().dateIso == existing().dateIso &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'graceClaimed',
                             'bonusGraceCredits',
                             'updatedAt'
                           ])
                         ) ||
                         // Action 3: Toggle Eco Lite Mode preference
                         (
                           incoming().dateIso == existing().dateIso &&
                           incoming().diff(existing()).affectedKeys().hasAny(['ecoLiteMode']) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'ecoLiteMode',
                             'updatedAt'
                           ])
                         ) ||
                         // Action 4: Daily rollover reset when dateIso advances (preserves ecoLiteMode)
                         (
                           incoming().dateIso != existing().dateIso &&
                           incoming().architectUsed == 0 &&
                           incoming().visionUsed == 0 &&
                           incoming().coachUsed == 0 &&
                           incoming().bonusGraceCredits == 0 &&
                           incoming().graceClaimed == false &&
                           incoming().fallbackCascadeCount == 0 &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'dateIso',
                             'architectUsed',
                             'visionUsed',
                             'coachUsed',
                             'bonusGraceCredits',
                             'graceClaimed',
                             'fallbackCascadeCount',
                             'updatedAt'
                           ])
                         )
                       );

      // Disallow deleting daily quota ledger to prevent quota-reset abuse
      allow delete: if false;
    }
  }
}
